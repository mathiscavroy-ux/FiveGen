# Copie ce fichier en .env puis remplis-le. Ce fichier reste sur le serveur : jamais visible des clients.

# --- Moteur de génération : OpenRouter (recommandé) ---
# Une seule clé pour les modèles gratuits (":free") et les modèles payants très bon marché.
# Clé gratuite, sans carte : https://openrouter.ai/settings/keys
# Sans crédit acheté : 50 requêtes gratuites par jour (environ 4 à 8 scripts).
# Après un achat unique de 10 $ de crédit : 1 000 requêtes gratuites par jour, et les crédits
# paient les modèles ci-dessous (GLM-5.3 : environ 0,05 à 0,15 $ le script, contre 0,5 à 1,3 $ avec Opus).
# Un modèle payant sans crédit répond 402 : FiveGen passe alors tout seul au modèle suivant de la liste.
ENGINE_BASE_URL=https://openrouter.ai/api/v1
ENGINE_API_KEY=
# Comptes Premium / Pro : GLM-5.3, le modèle ouvert le plus proche d'Opus en code, puis
# DeepSeek V4 Pro, puis le meilleur modèle gratuit en dernier recours.
ENGINE_MODEL=z-ai/glm-5.3
ENGINE_FALLBACK_MODELS=deepseek/deepseek-v4-pro,nvidia/nemotron-3-ultra-550b-a55b:free
ENGINE_MAX_TOKENS=64000
# Nom du moteur affiché aux clients (sinon déduit de ENGINE_MODEL)
PREMIUM_ENGINE_NAME=GLM-5.3
# 100 % gratuit (aucun crédit) : mets les modèles gratuits partout, et un nom honnête :
# ENGINE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# ENGINE_FALLBACK_MODELS=cohere/north-mini-code:free,recursive/flint-v1.0:free
# ENGINE_LIGHT_MODEL=nvidia/nemotron-3.5-lightning:free
# ENGINE_REVIEW_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# PREMIUM_ENGINE_NAME=Nemotron 3 Ultra
# Autre fournisseur compatible OpenAI (Gemini, Mistral…) : change ENGINE_BASE_URL et les modèles.
# ENGINE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Niveau de réflexion : génération d'une ressource, puis modifications / corrections / relecture.
# low | medium | high (envoyé seulement si le modèle le propose). Mesuré sur un script complet :
# low 4 min et 1 erreur, medium 8,5 min et fichier coupé, sans niveau 6-7 min d'écran figé.
# ENGINE_EFFORT=low
# ENGINE_EFFORT_EDITS=low
# Génération abandonnée (puis relancée ou remboursée) après ce silence du moteur, en secondes
# ENGINE_STALL_SECONDS=90
# Modèle plus rapide pour l'étape des questions (même fournisseur), sinon ENGINE_MODEL
# BRIEF_MODEL=
# Modèle moins cher (même fournisseur) pour les fichiers simples d'une génération parallèle
# (fxmanifest, README, traductions, SQL, HTML/CSS) et pour la relecture. Ignoré s'il n'existe
# pas chez le fournisseur ; le code client/serveur reste sur ENGINE_MODEL. Vide = désactivé.
ENGINE_LIGHT_MODEL=z-ai/glm-5.3-flash
ENGINE_REVIEW_MODEL=z-ai/glm-5.3-flash
# Moteur de secours chez un autre fournisseur compatible OpenAI (Mistral, OpenRouter…),
# utilisé si le principal est en panne, sans quota ou mal configuré
# FALLBACK_BASE_URL=https://api.mistral.ai/v1
# FALLBACK_API_KEY=
# FALLBACK_MODEL=mistral-large-latest
# FALLBACK_MAX_TOKENS=32000

# --- Qualité ---
# Meilleur de N : le code (config, client, serveur) est écrit en même temps par les N premiers
# modèles de la liste (ENGINE_MODEL puis ENGINE_FALLBACK_MODELS) ; la vérification garde la
# version qui a le moins d'erreurs. Le code coûte environ N fois plus, sans attente en plus :
# une version concurrente lente est abandonnée (moitié du temps de la première, 30 s minimum).
# ENGINE_CANDIDATES=2
# Comptes gratuits : 2 par défaut pour comparer deux versions et garder la plus propre.
# FREE_CANDIDATES=2
# Jusqu'à 8 corrections ciblées par fichier sur le gratuit (AUTO_FIX_ROUNDS reste le minimum).
# FREE_AUTO_FIX_ROUNDS=8
# RIVAL_GRACE_MS=30000
# Correction automatique : quand un tour n'améliore pas le script, le modèle suivant le
# retente (nombre d'autres modèles essayés par tour ; 0 pour arrêter au premier échec).
# FIX_ESCALATION=1

# --- Mémoire FiveM (leçons apprises) ---
# Chaque erreur de la vérification qu'une correction automatique fait disparaître devient une
# règle générale (jamais de code ni de nom tiré du script du client). Une règle confirmée par
# LESSONS_AUTO_APPROVE scripts s'active seule (0 : seulement à la main dans /admin > Qualité),
# puis chaque génération et chaque correction la reçoit. LESSONS=0 coupe tout.
# LESSONS=1
# LESSONS_AUTO_APPROVE=3
# LESSONS_PER_DAY=20
# LESSONS_MAX=15
# Modèles qui écrivent les règles (vide : ceux de Pro, puis les gratuits)
# LESSONS_MODELS=

# --- Autres fournisseurs (plus de quota gratuit, relais en cas de panne) ---
# Un modèle d'un autre fournisseur s'écrit « modèle@nom » dans n'importe quelle liste
# (ENGINE_FALLBACK_MODELS, FREE_MODELS, ENGINE_LIGHT_MODEL…). Vérifie les conditions de
# chaque offre gratuite : NVIDIA NIM est réservé au développement, Gemini gratuit ne peut pas
# servir des clients dans l'UE, Mistral gratuit est prévu pour l'évaluation.
# PROVIDERS=nim,mistral
# PROVIDER_NIM_URL=https://integrate.api.nvidia.com/v1
# PROVIDER_NIM_KEY=
# PROVIDER_MISTRAL_URL=https://api.mistral.ai/v1
# PROVIDER_MISTRAL_KEY=
# PROVIDER_MISTRAL_MAX_TOKENS=32000
# Exemple : ENGINE_FALLBACK_MODELS=deepseek/deepseek-v4-pro,deepseek-ai/deepseek-v4.1-flash@nim

# --- Site ---
PORT=3210
# 127.0.0.1 derrière un reverse proxy (recommandé), 0.0.0.0 pour écouter sur toutes les interfaces
HOST=127.0.0.1
PUBLIC_URL=https://fivegen.example.com
NODE_ENV=production
# 1 si le site est derrière Caddy / Nginx / Cloudflare (IP réelle des clients pour l'anti-abus)
TRUST_PROXY=1

# --- Vente ---
# Ton e-mail : le compte créé avec cette adresse devient administrateur (/admin)
ADMIN_EMAIL=
# Crédits offerts à l'inscription
# Crédits offerts à l'inscription (3 = un script)
FREE_CREDITS=3
# Nombre de comptes par adresse IP qui reçoivent les crédits offerts (sur 30 jours)
# FREE_CREDITS_PER_IP=2
# Coût en crédits de chaque action (les corrections automatiques sont gratuites)
# Un script complet consomme ~0,5 à 1,3 $ de quota moteur selon sa taille
COST_GENERATE=3
COST_REFINE=1
COST_FIX=0
# Scripts importés par le client : conversion vers un autre framework, optimisation des performances
COST_CONVERT=3
COST_OPTIMIZE=2
# Modifications offertes sur chaque script avant de payer COST_REFINE
FREE_REFINES=3
AUTO_FIX_ROUNDS=2
# Relecture par le moteur juste après chaque génération (sécurité, nettoyage, demandes du client). 0 pour la couper.
REVIEW_PASS=1
REVIEW_CHANGES=1
# Nouveaux scripts : plan puis groupes de fichiers écrits en parallèle (0 pour un seul appel).
PARALLEL_GENERATION=1
# Test d'exécution des scripts dans un FiveM simulé avant livraison. 0 pour le couper.
SMOKE_TEST=1
# --- Paiement par carte (Stripe) : packs achetés sur le site, crédits ajoutés automatiquement ---
# Clé secrète : dashboard.stripe.com > Développeurs > Clés API (sk_test_... pour tester, sk_live_... en vrai)
STRIPE_SECRET_KEY=
# Secret du webhook : Développeurs > Webhooks > endpoint https://ton-site/api/stripe/webhook
# (événements : checkout.session.completed, checkout.session.async_payment_succeeded,
#  invoice.paid, customer.subscription.updated, customer.subscription.deleted)
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
# Code fiscal du produit (obligatoire avec Managed Payments). Par défaut : services fournis par voie électronique
# STRIPE_TAX_CODE=txcd_10000000
# Packs (prix TTC en centimes, ce que paie le client). Facultatif, sinon Starter 15/8,99 €, Pro 45/23,99 €, Studio 150/71,99 €
# Abonnements Premium et Pro : le moteur le plus puissant et des avantages, les scripts coûtent
# toujours des crédits. Prix TTC en centimes (par défaut 9,99 € et 19,99 € par mois).
# PREMIUM_PRICE=999
# PRO_PRICE=1999
# Avantages : modifications offertes par script et serveurs FiveM connectables
# PREMIUM_FREE_REFINES=5
# PRO_FREE_REFINES=10
# FREE_MAX_SERVERS=2
# PREMIUM_MAX_SERVERS=5
# PRO_MAX_SERVERS=10
# Comptes gratuits : modèles gratuits du fournisseur, essayés dans l'ordre (uniquement gratuits :
# jamais le moteur de secours FALLBACK_*). Les abonnés utilisent ENGINE_MODEL.
# Par défaut (OpenRouter) : Nemotron 3 Ultra, puis deux petits modèles de code. Nom affiché déduit du premier.
# FREE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,recursive/flint-v1.0:free
# FREE_LIGHT_MODEL=nvidia/nemotron-3.5-lightning:free
# FREE_REVIEW_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# FREE_BRIEF_MODEL=nvidia/nemotron-3.5-lightning:free
# FREE_ENGINE_NAME=Nemotron 3 Ultra
# CREDIT_PACKS=[{"id":"starter","name":"Starter","credits":15,"price":899},{"id":"pro","name":"Pro","credits":45,"price":2399,"featured":true},{"id":"studio","name":"Studio","credits":150,"price":7199}]

# Page externe où acheter des codes, si Stripe n'est pas configuré (Tebex, boutique Discord…)
SHOP_URL=
# Lien de support (Discord, e-mail…)
SUPPORT_URL=

# --- E-mails (mot de passe oublié, confirmation d'adresse) ---
# alwaysdata : Emails > Adresses, crée par ex. noreply@ton-domaine, puis serveur smtp-<compte>.alwaysdata.net
# Sans SMTP_HOST : pas de confirmation d'adresse (crédits offerts tout de suite) et liens écrits dans les logs.
# SMTP_HOST=log active la confirmation mais écrit seulement les e-mails dans les logs (pour tester).
# SMTP_HOST=smtp-moncompte.alwaysdata.net
# SMTP_PORT=587
# SMTP_USER=noreply@ton-domaine.fr
# SMTP_PASS=
# MAIL_FROM=noreply@ton-domaine.fr

# --- Sauvegardes (npm run backup) ---
# BACKUP_DIR=/home/moncompte/backups
# BACKUP_KEEP=14

# ---------- Connexion avec Discord (facultatif) ----------
# discord.com/developers/applications > New Application > OAuth2 :
# Redirects : https://ton-site/api/auth/discord/callback ; copie Client ID et Client Secret.
# Le bouton « Continuer avec Discord » n'apparaît qu'une fois les deux renseignés.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
